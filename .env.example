# FocusFlow — Environment Configuration

# GEMINI_API_KEY: Required for Gemini AI Study Companion.
# In AI Studio, this is automatically injected at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: Optional MongoDB connection URI.
# If omitted or if MongoDB daemon is unreachable, FocusFlow automatically
# operates with its built-in in-memory fallback store without crashes.
MONGODB_URI="mongodb://127.0.0.1:27017/focusflow"

# JWT_SECRET: Secret used to sign user authentication tokens.
JWT_SECRET="focusflow-production-jwt-secret-replace-in-production"

# PORT: Server port (defaults to 3000)
PORT=3000
